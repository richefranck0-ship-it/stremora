# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where STREAMORA is hosted (used for SEO canonical links, sitemap.xml, and Web Push).
APP_URL="http://localhost:3000"

# ADMIN_PASSWORD: Secret password required to authenticate on the private /admin panel.
# Never commit real passwords to version control; set this in your environment or .env file.
ADMIN_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"

# ADMIN_SESSION_SECRET: Random secret string for signing HTTP-only admin session cookies.
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"

# VAPID KEYS for Web Push Notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@streamora.app"

# VITE_TMDB_API_KEY: Optional custom TMDB v3 API key.
VITE_TMDB_API_KEY=""
